{
  "name": "demo-js-rewrite",
  "version": "0.1.0",
  "description": "Java->JS rewrite of demo app with Vitest tests and coverage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --exec node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "c8": "^11.0.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3",
    "vitest": "^1.0.0"
  },
  "type": "module"
}
