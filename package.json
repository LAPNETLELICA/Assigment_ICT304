{
  "name": "demo-js-rewrite",
  "version": "0.1.0",
  "description": "Java->JS rewrite of demo app with Vitest tests and coverage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --exec node src/server.js",
    "test": "vitest",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=html -- vitest run"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3",
    "vitest": "^1.0.0"
  }
}
